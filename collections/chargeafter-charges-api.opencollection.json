                "description": "The charge ID as received in the response of the original charge operation."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Process a refund for a previously settled amount.\nThis action facilitates the return of funds to the customer for various reasons, such as returned goods or canceled services."
        },
        {
          "info": {
            "name": "Void a Charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.ca-dev.co/v2/post-sale/charges/:chargeid/voids",
