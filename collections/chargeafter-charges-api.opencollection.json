            "params": [
              {
                "name": "chargeid",
                "value": "",
                "type": "path",
                "description": "The charge ID as received in the response of the original charge operation."
              }
            ]
          },
          "docs": "Fetching updated information of an existing Charge"
        },
        {
          "info": {
            "name": "Update a Charge",
            "type": "http"
