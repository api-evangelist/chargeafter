            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.ca-dev.co/v2/post-sale/charges",
            "params": [
              {
                "name": "settle",
                "value": "",
                "type": "query",
                "description": "(Optional)\n            \nA flag indicating whether a settle request should be sent to the lender as well."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new charge by initiating a new authorize transaction.\nUse the returned ChargedId for other post-sale operations"
        },
        {
          "info": {
            "name": "Get details of a Charge",
            "type": "http"
