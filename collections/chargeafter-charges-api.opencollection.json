                "description": "The charge ID as received in the response of the original charge operation."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Cancel and invalidate an authorized charge before it is settled.\nThis action prevents the charge from being completed or appearing on the customer's statement.\nUse voiding for transactions that need to be canceled early in the process."
        },
